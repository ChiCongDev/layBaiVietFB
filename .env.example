# Database MySQL (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=crawl_facebook

# Facebook Credentials (dùng để đăng nhập)
FB_EMAIL=your_facebook_email
FB_PASSWORD=your_facebook_password

# Hoặc dùng Cookies (an toàn hơn)
# Lấy cookies bằng cách: F12 -> Application -> Cookies -> facebook.com
# Copy tất cả cookies thành chuỗi
FB_COOKIES=

# Group URL cần crawl
FB_GROUP_URL=https://www.facebook.com/groups/5375930115830753

# Cấu hình crawler
CRAWL_LIMIT=10
HEADLESS=false

# Đường dẫn Chrome/Edge (nếu không tự động tìm được)
# BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
